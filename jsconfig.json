{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "api/diagnostic.js",
    "scripts/build.mjs",
    "scripts/lint.mjs",
    "assets/analytics.js"
  ]
}
